# Template for production. Copy to .env.prod.local (gitignored), fill in, then:
#   docker compose --env-file .env.prod.local -f compose.yaml -f compose.prod.yaml up -d
# See compose.prod.yaml for details.

HTTP_PORT="80"

# openssl rand -hex 32
APP_SECRET=""

# Public URL of the site (no trailing slash) and the matching CORS regex.
DEFAULT_URI="https://gearshare.example.com"
CORS_ALLOW_ORIGIN="^https://gearshare\.example\.com$"

# Database. The password ends up in a URL: stick to [A-Za-z0-9] or URL-encode it.
POSTGRES_DB="app"
POSTGRES_USER="app"
POSTGRES_PASSWORD=""

# Object storage credentials (any long random strings).
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# OAuth apps (callback: <DEFAULT_URI>/connect/<provider>/check)
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
OAUTH_MS_CLIENT_ID=""
OAUTH_MS_CLIENT_SECRET=""
OAUTH_MS_TENANT_ID=""

# Pin a SeaweedFS release instead of latest.
# SEAWEEDFS_VERSION=
